{
  "name": "musicbofangqi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "build:exe": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.tahoe.hifi.player",
    "productName": "Tahoe-HiFi",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Tahoe-HiFi-Portable.exe"
    }
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "framer-motion": "^14.6.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "music-metadata-browser": "^2.5.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.0.5"
  }
}
